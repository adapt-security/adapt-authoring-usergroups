{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$anchor": "usergroups",
  "description": "Group memberships for a user",
  "type": "object",
  "$patch": {
    "source": { "$ref": "user" },
    "with": {
      "properties": {
        "userGroups": {
          "description": "User groups this user belongs to",
          "type": "array",
          "items": {
            "type": "string",
            "isObjectId": true
          },
          "_adapt": { "inputType": "UserGroups" }
        }
      }
    }
  }
}
